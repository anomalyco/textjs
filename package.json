{
  "name": "textjs-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {"type": "git", "url": "git+https://github.com/adamdotdevin/textjs.git"},
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
    "build:packages": "bun run --filter '@textjs/core' build && bun run --filter '@textjs/react' build && bun run --filter 'textjs' build && bun run --filter 'create-text-app' build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:opencode": "bun run --cwd apps/opencode-console dev",
    "dev:dashboard": "bun run --cwd examples/dashboard dev",
    "test": "bun test packages/",
    "typecheck": "tsc -b packages/core packages/react packages/text packages/create-text-app"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-reconciler": "^0.34.1",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-reconciler": "^0.34.0",
    "scheduler": "^0.27.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "yoga-layout": "^3.2.1"
  }
}
