{
  "name": "@textjs/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "textjs.org \u2014 the official Text.js website, playground, OpenCode showcase and documentation.",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "bun scripts/build.ts",
    "i18n:translate": "bun scripts/i18n/translate.ts",
    "i18n:check": "bun scripts/i18n/check.ts",
    "i18n:readme": "bun scripts/i18n/readme.ts",
    "preview": "vite preview --port 3000",
    "og": "bun scripts/generate-og.ts",
    "og:preview": "bun scripts/og/preview.ts",
    "og:share": "bun scripts/og/share.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/fixtures/acme-deploys",
    "test": "bun test --parallel",
    "check:links": "bun scripts/check-links.ts",
    "preview:functions": "bunx wrangler pages dev dist --port 8788 --compatibility-date 2026-10-01",
    "deploy": "bunx wrangler pages deploy dist --project-name textjs"
  },
  "dependencies": {
    "@textjs/core": "workspace:*",
    "@textjs/font": "workspace:*",
    "@textjs/react": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@textjs/app": "workspace:*",
    "@textjs/terminal-shop": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "playwright-core": "1.62.1",
    "vite": "^6.3.5"
  }
}
