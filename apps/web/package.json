{
  "name": "@textjs/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "textjs.org — the official Text.js website, playground, OpenCode showcase and documentation.",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && bun scripts/postbuild-pages.ts",
    "preview": "vite preview --port 3000",
    "og": "bun scripts/generate-og.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@textjs/core": "workspace:*",
    "@textjs/react": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "textjs": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5"
  }
}
