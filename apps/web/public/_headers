# Cloudflare Pages: headers for static responses (Functions under /api/terminal and
# /terminal/callback set their own, stricter ones). No page Content-Security-Policy beyond
# frame-ancestors: pages use inline scripts and styles, and a script/connect policy would
# need auditing every page (and the OpenCode bridge at 127.0.0.1:4096) first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Powered-By: Text.js

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and Open Graph cards aren't content-hashed, so a day, not a year: repeat visits and link
# unfurls skip the revalidation round trip, and a changed file still shows up within a day.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
