    ]
  },
  "Text.js error boundary": {
    "prefix": "txerror",
    "description": "▼ error.tsx boundary with retry",
    "body": [
      "import { Box, Text, useInput, useTheme, type ErrorComponentProps } from \"@textjs/next\";",
      "",
      "export default function Error({ error, reset }: ErrorComponentProps) {",
      "  const theme = useTheme();",
      "  useInput((e) => {",
      "    if (e.input === \"r\") reset();",
      "  });",
      "  return (",
      "    <Box className=\"flex-col gap-1 border rounded px-1\" borderColor={theme.danger}>",
      "      <Text bold color={theme.danger}>${1:Something went wrong}</Text>",
      "      <Text color={theme.muted}>{error.message}</Text>",
      "      <Text color={theme.subtle}>r retry</Text>",
      "    </Box>",
      "  );",
      "}",
      ""
    ]
  },
