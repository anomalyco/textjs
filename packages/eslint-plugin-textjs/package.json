{
  "name": "eslint-plugin-textjs",
  "version": "1.0.4",
  "description": "ESLint rules for Text.js: console-safe JSX, cell-width glyphs, frame-paced timers, keymaps and App Router conventions.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org/docs/eslint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/eslint-plugin-textjs"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": ["eslint", "eslintplugin", "eslint-plugin", "textjs", "react", "console", "tui"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json && bun ../../scripts/esm-specifiers.ts dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "lint:repo": "bun scripts/lint-repo.ts"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "eslint": "^9.39.5"
  }
}
