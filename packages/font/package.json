{
  "name": "@textjs/font",
  "version": "0.2.0",
  "description": "next/font for FIGlet: a FIGlet 2.2 .flf parser and renderer with 17 bundled, tree-shakable FIGfonts for Text.js.",
  "type": "module",
  "license": "MIT AND BSD-3-Clause",
  "sideEffects": false,
  "keywords": ["figlet", "flf", "ascii-art", "banner", "console", "textjs"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./all": "./src/all.ts",
    "./package.json": "./package.json",
    "./*": "./src/fonts/*.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./all": {
        "types": "./dist/all.d.ts",
        "default": "./dist/all.js"
      },
      "./package.json": "./package.json",
      "./*": {
        "types": "./dist/fonts/*.d.ts",
        "default": "./dist/fonts/*.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSES",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "generate": "bun scripts/generate-fonts.ts",
    "references": "bun scripts/generate-references.ts"
  },
  "peerDependencies": {
    "@textjs/react": "^0.2.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@textjs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@textjs/react": "workspace:*"
  }
}
