{
  "name": "@textjs/core",
  "version": "1.0.4",
  "description": "Text.js core engine: CellBuffer, Yoga layout scene graph, text measurement, input and console drivers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org/docs/turbolog-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": ["textjs", "console", "devtools", "tui", "yoga", "layout", "renderer"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun ../../scripts/esm-specifiers.ts dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "bench": "bun test test/perf.test.ts"
  },
  "dependencies": {
    "yoga-layout": "^3.2.1"
  }
}
