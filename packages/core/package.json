{
  "name": "@textjs/core",
  "version": "1.5.0",
  "description": "Text.js core engine: CellBuffer, Yoga layout scene graph, text measurement, input and console drivers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org/docs/turbolog-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": ["textjs", "console", "devtools", "tui", "yoga", "layout", "renderer"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./experimental": {
      "types": "./src/experimental.ts",
      "default": "./src/experimental.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "default": "./src/internal.ts"
    },
    "./yoga.wasm": "./yoga.wasm",
    "./package.json": "./package.json"
  },
  "imports": {
    "#yoga-loader": {
      "workerd": "./src/yoga-loader.workerd.ts",
      "@textjs/wasm-asset": "./src/yoga-loader.browser.ts",
      "default": "./src/yoga-loader.inline.ts"
    },
    "#bidi-loader": {
      "@textjs/wasm-asset": "./src/bidi-loader.browser.ts",
      "default": "./src/bidi-loader.inline.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./experimental": {
        "types": "./dist/experimental.d.ts",
        "default": "./dist/experimental.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./yoga.wasm": "./yoga.wasm"
    },
    "imports": {
      "#yoga-loader": {
        "workerd": "./dist/yoga-loader.workerd.js",
        "@textjs/wasm-asset": "./dist/yoga-loader.browser.js",
        "default": "./dist/yoga-loader.inline.js"
      },
      "#bidi-loader": {
        "@textjs/wasm-asset": "./dist/bidi-loader.browser.js",
        "default": "./dist/bidi-loader.inline.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "yoga.wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun ../../scripts/esm-specifiers.ts dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "bench": "bun test test/perf.test.ts"
  },
  "dependencies": {
    "yoga-layout": "3.2.1"
  }
}
