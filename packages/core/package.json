{
  "name": "@textjs/core",
  "version": "0.1.0",
  "description": "Text.js core engine: CellBuffer, Yoga layout scene graph, text measurement, input and console drivers.",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/adamdotdevin/textjs.git", "directory": "packages/core"},
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test",
    "bench": "bun test test/perf.test.ts"
  },
  "dependencies": {
    "yoga-layout": "^3.2.1"
  }
}
