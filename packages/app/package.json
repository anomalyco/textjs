{
  "name": "@textjs/app",
  "version": "1.0.4",
  "description": "The Console Framework for the Web. Build React 19 App Router apps that render in the DevTools console.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://textjs.org",
  "keywords": ["react", "console", "devtools", "tui", "framework", "app-router"],
  "bin": {
    "text": "bin/text.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./navigation": "./src/navigation.ts",
    "./link": "./src/link.tsx",
    "./router": "./src/router.tsx",
    "./devtools": "./src/devtools.tsx",
    "./client": "./src/client.tsx",
    "./vite": "./src/vite-plugin.ts",
    "./testing": "./src/testing.ts",
    "./terminal": "./src/terminal.ts",
    "./server": "./src/server/middleware.ts",
    "./cache": "./src/server/cache.ts",
    "./live-app": "./src/server/live-app.tsx",
    "./live-player": "./src/live-player.ts",
    "./live-stub": "./src/live-stub.tsx",
    "./live-protocol": "./src/live-protocol.ts",
    "./server-components": "./src/server/server-components.ts",
    "./server/jsx-runtime": "./src/server/jsx-runtime.ts",
    "./server/jsx-dev-runtime": "./src/server/jsx-dev-runtime.ts",
    "./mcp": "./src/mcp/index.ts",
    "./frame-protocol": "./src/frame-protocol.ts",
    "./cli": "./src/cli/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./navigation": { "types": "./dist/navigation.d.ts", "default": "./dist/navigation.js" },
      "./link": { "types": "./dist/link.d.ts", "default": "./dist/link.js" },
      "./router": { "types": "./dist/router.d.ts", "default": "./dist/router.js" },
      "./devtools": { "types": "./dist/devtools.d.ts", "default": "./dist/devtools.js" },
      "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
      "./vite": { "types": "./dist/vite-plugin.d.ts", "default": "./dist/vite-plugin.js" },
      "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
      "./terminal": { "types": "./dist/terminal.d.ts", "default": "./dist/terminal.js" },
      "./server": { "types": "./dist/server/middleware.d.ts", "default": "./dist/server/middleware.js" },
      "./cache": { "types": "./dist/server/cache.d.ts", "default": "./dist/server/cache.js" },
      "./live-app": { "types": "./dist/server/live-app.d.ts", "default": "./dist/server/live-app.js" },
      "./live-player": { "types": "./dist/live-player.d.ts", "default": "./dist/live-player.js" },
      "./live-stub": { "types": "./dist/live-stub.d.ts", "default": "./dist/live-stub.js" },
      "./live-protocol": { "types": "./dist/live-protocol.d.ts", "default": "./dist/live-protocol.js" },
      "./server-components": { "types": "./dist/server/server-components.d.ts", "default": "./dist/server/server-components.js" },
      "./server/jsx-runtime": { "types": "./dist/server/jsx-runtime.d.ts", "default": "./dist/server/jsx-runtime.js" },
      "./server/jsx-dev-runtime": { "types": "./dist/server/jsx-dev-runtime.d.ts", "default": "./dist/server/jsx-dev-runtime.js" },
      "./mcp": { "types": "./dist/mcp/index.d.ts", "default": "./dist/mcp/index.js" },
      "./frame-protocol": { "types": "./dist/frame-protocol.d.ts", "default": "./dist/frame-protocol.js" },
      "./cli": { "types": "./dist/cli/index.d.ts", "default": "./dist/cli/index.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["bin", "dist", "src"],
  "scripts": {
    "build": "tsc -b tsconfig.json && bun ../../scripts/esm-specifiers.ts ../core/dist ../react/dist ../opencode/dist dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@textjs/core": "workspace:*",
    "@textjs/opencode": "workspace:*",
    "@textjs/react": "workspace:*",
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "zod": "^4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
