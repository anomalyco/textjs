{
  "name": "create-text-app",
  "version": "1.0.1",
  "description": "Create Text.js apps — React App Router apps that render inside DevTools console.log.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org",
  "bin": {
    "create-text-app": "bin/create-text-app.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["bin", "dist", "src", "templates"],
  "scripts": {
    "build": "tsc -b tsconfig.json && bun ../../scripts/build-bin.ts bin/create-text-app.ts dist/bin/create-text-app.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test"
  }
}
