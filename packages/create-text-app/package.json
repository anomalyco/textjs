{
  "name": "create-text-app",
  "version": "1.4.1",
  "description": "Scaffold a Text.js app from the starter, dashboard or opencode template.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textjs.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/create-text-app"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": ["textjs", "create-text-app", "react", "console", "devtools", "tui", "starter"],
  "bin": {
    "create-text-app": "bin/create-text-app.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["bin", "dist", "src", "templates"],
  "scripts": {
    "build": "tsc -b tsconfig.json && bun ../../scripts/build-bin.ts bin/create-text-app.ts dist/bin/create-text-app.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test"
  }
}
