{
  "name": "@textjs/opencode",
  "version": "1.2.0",
  "description": "A loopback bridge that connects textjs.org/opencode to the OpenCode server on your machine.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://textjs.org/docs/opencode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/textjs.git",
    "directory": "packages/opencode"
  },
  "bugs": "https://github.com/anomalyco/textjs/issues",
  "keywords": ["opencode", "textjs", "cors", "proxy", "bridge"],
  "bin": {
    "textjs-opencode": "bin/textjs-opencode.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./key-defaults": "./src/key-defaults.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./cli": { "types": "./dist/cli.d.ts", "default": "./dist/cli.js" },
      "./key-defaults": { "types": "./dist/key-defaults.d.ts", "default": "./dist/key-defaults.js" },
      "./package.json": "./package.json"
    }
  },
  "files": ["bin/textjs-opencode.js", "dist", "!dist/.tsbuildinfo"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && bun ../../scripts/esm-specifiers.ts dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test"
  }
}
